clc;
clear;
close all;

%% Massive MIMO Capacity vs SNR and Antenna Gain

% Parameters
Nt_values = [4 8 16 32];     % Number of transmit antennas
Nr = 4;                       % Number of receive antennas
SNR_dB = 0:2:30;              % SNR range in dB

% Pre-allocate capacity
Capacity = zeros(length(Nt_values), length(SNR_dB));

%% Calculate MIMO Capacity

for a = 1:length(Nt_values)

    Nt = Nt_values(a);

    for s = 1:length(SNR_dB)

        % Convert SNR from dB to linear
        SNR = 10^(SNR_dB(s)/10);

        % Generate Rayleigh fading MIMO channel
        H = (randn(Nr,Nt) + 1j*randn(Nr,Nt))/sqrt(2);

        % MIMO capacity formula
        C = real(log2(det( ...
            eye(Nr) + (SNR/Nt)*(H*H') )));

        Capacity(a,s) = C;

    end
end

%% Plot Capacity vs SNR

figure;

plot(SNR_dB, Capacity(1,:), 'LineWidth', 2);
hold on;
plot(SNR_dB, Capacity(2,:), 'LineWidth', 2);
plot(SNR_dB, Capacity(3,:), 'LineWidth', 2);
plot(SNR_dB, Capacity(4,:), 'LineWidth', 2);

grid on;

xlabel('SNR (dB)');
ylabel('Channel Capacity (bits/s/Hz)');
title('Massive MIMO Capacity vs SNR');

legend('4 Antennas', ...
       '8 Antennas', ...
       '16 Antennas', ...
       '32 Antennas');

xlim([0 30]);

%% Display Maximum Capacity

fprintf('\nMassive MIMO Capacity Results\n');
fprintf('-----------------------------\n');

for a = 1:length(Nt_values)

    fprintf('%2d Antennas : %.2f bits/s/Hz\n', ...
        Nt_values(a), max(Capacity(a,:)));

end
